GEMINI_API_KEY=
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# gemini | ollama - ollama is the local fallback when Gemini quota is spent
LLM_PROVIDER=gemini
OLLAMA_MODEL=llama3.2:3b
# openai = any OpenAI-compatible endpoint (OmniRoute, Groq, OpenRouter...)
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=
OPENAI_MODEL=auto/best-free
